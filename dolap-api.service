[Unit]
Description=Dolap API (kombin uygulamasi)
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/dolap
ExecStart=/home/ubuntu/dolap/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8090 --proxy-headers --no-server-header
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
